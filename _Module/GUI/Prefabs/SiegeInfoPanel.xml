<Prefab>
  <Window>
    <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Companion panel, to the right of the left game menu. Cards are clickable when an action is set. -->
        <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="470" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="570" Sprite="text_box_9">
          <Children>
            <ListPanel DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="24" MarginRight="24" MarginTop="20" MarginBottom="20" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" Brush="GameMenu.Siege.Title" Text="@Title" />

                <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" Sprite="GradientDivider_9" AlphaFactor="0.4" />

                <!-- Scroll up: shown when earlier engines are hidden -->
                <ButtonWidget DoNotPassEventsToChildren="true" IsVisible="@CanScrollUp" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" MarginTop="6" Brush="GameMenu.Button" Command.Click="ExecuteScrollUp">
                  <Children>
                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="GameMenu.Items.Text.Default" Brush.FontSize="20" Text="^  Scroll up" />
                  </Children>
                </ButtonWidget>

                <!-- The cards on this page. Picture on the left, stats on the right. The whole card is a button. -->
                <ListPanel DataSource="{Cards}" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <ItemTemplate>
                    <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="8" MarginBottom="2" Brush="GameMenu.Button" Command.Click="ExecuteAction">
                      <Children>
                        <ListPanel DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="8" MarginRight="8" MarginTop="8" MarginBottom="8" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>

                            <!-- Engine picture: one of the game's own siege sprites -->
                            <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="84" SuggestedHeight="84" VerticalAlignment="Top" Sprite="BlankWhiteSquare_9" Color="#00000066">
                              <Children>
                                <Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="4" MarginRight="4" MarginTop="4" MarginBottom="4" Sprite="@SpritePath" />
                              </Children>
                            </Widget>

                            <!-- Name, stats, and what a click does -->
                            <ListPanel DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="16" StackLayout.LayoutMethod="VerticalTopToBottom">
                              <Children>
                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" Brush="GameMenu.Items.Text.Default" Brush.FontSize="26" Text="@Name" />
                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Brush="GameMenu.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" Text="@Line1" />
                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Brush="GameMenu.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" Text="@Line2" />
                                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Brush="GameMenu.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" Text="@Line3" />
                                <RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="4" Brush="GameMenu.InfoText" Brush.FontSize="18" Brush.TextHorizontalAlignment="Left" Text="@Description" />
                                <TextWidget DoNotAcceptEvents="true" IsVisible="@HasActionText" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginTop="6" Brush="GameMenu.Siege.Title" Brush.FontSize="20" Brush.TextHorizontalAlignment="Left" Text="@ActionText" />
                              </Children>
                            </ListPanel>

                          </Children>
                        </ListPanel>
                      </Children>
                    </ButtonWidget>
                  </ItemTemplate>
                </ListPanel>

                <!-- Scroll down: shown when more engines are hidden below -->
                <ButtonWidget DoNotPassEventsToChildren="true" IsVisible="@CanScrollDown" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="36" MarginTop="6" Brush="GameMenu.Button" Command.Click="ExecuteScrollDown">
                  <Children>
                    <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="GameMenu.Items.Text.Default" Brush.FontSize="20" Text="v  Scroll down" />
                  </Children>
                </ButtonWidget>

                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" MarginTop="4" Brush="GameMenu.InfoText" Brush.FontSize="18" Text="@PageText" />

              </Children>
            </ListPanel>
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
